# systemd unit for TuneShuttle (docs/PLAN.md "Deployment"). Install:
#   sudo cp tune-shuttle.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now tune-shuttle
[Unit]
Description=TuneShuttle (Spotify Connect to AirPlay 2 bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=tune-shuttle
WorkingDirectory=/opt/tune-shuttle
ExecStart=/opt/tune-shuttle/bridge
Environment=BRIDGE_DataDirectory=/var/lib/tune-shuttle
# The web endpoint goes through the bridge's own configuration: appsettings.json has a Kestrel:Endpoints entry, which
# overrides ASPNETCORE_URLS, so the port is set with the same key (BRIDGE_ prefix, __ as separator).
Environment=BRIDGE_Kestrel__Endpoints__Http__Url=http://0.0.0.0:8080
Restart=on-failure
RestartSec=5
# The pacer wants a real-time-ish scheduling class; allow it to raise its priority.
LimitRTPRIO=20
AmbientCapabilities=CAP_SYS_NICE

[Install]
WantedBy=multi-user.target
