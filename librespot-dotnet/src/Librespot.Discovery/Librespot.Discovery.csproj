<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Librespot.Discovery</RootNamespace>
    <Description>Port of librespot-discovery: advertises the device via mDNS/DNS-SD and runs the zeroconf HTTP server that receives credentials.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Librespot.Core\Librespot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Librespot.Tests" />
    <!-- The AirPlay 2 sender reuses the mDNS packet codec (Mdns/DnsPacket.cs) for its receiver browser, and its tests
         run MdnsResponder as a loopback peer (docs/ARCHITECTURE.md, "Design decisions"). -->
    <InternalsVisibleTo Include="Airplay2.Sender" />
    <InternalsVisibleTo Include="Airplay2.Sender.Tests" />
    <!-- The AirPlay 2 receiver advertises through MdnsResponder (docs/airplay2/SPEC-receiver.md 5.1, 13). -->
    <InternalsVisibleTo Include="Airplay2.Receiver" />
    <InternalsVisibleTo Include="Airplay2.Receiver.Tests" />
  </ItemGroup>

</Project>
