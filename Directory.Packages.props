<Project>
  <!-- Central package management for src/ and tests/. Versions verified against api.nuget.org on 2026-10-09; Microsoft 10.0.x packages raised to 10.0.14 on 2026-10-26 (10.0.12 WebAssembly.Server has CVE-2026-102870 and CVE-2026-96230). -->
  <ItemGroup>
    <!-- Crypto: .NET 10 has ChaCha20-Poly1305, HKDF, SHA-512 and BigInteger natively; X25519 and Ed25519 are not in the BCL
         (verified: System.Security.Cryptography on 10.0.12 exports no *25519 type), so BouncyCastle supplies those two. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />

    <!-- Hosting and logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />

    <!-- Persistence: Microsoft.Data.Sqlite + Dapper (no EF Core: five tables, hand-written SQL is smaller and visible). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Dapper" Version="2.1.89" />

    <!-- Web app: Blazor WebAssembly hosted by Bridge.Service (no node toolchain needed). -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />

    <!-- AAC-LC decoding through libavcodec (SPEC-receiver.md R4, 7.2): FFmpeg.AutoGen 7.1.1 binds FFmpeg 7.1 (avcodec-61,
         avutil-59, swresample-5); checked on api.nuget.org 2026-10-26 (9.0.1.1 is current but has no distribution packages
         of its major). Bindings LGPL-3.0 (LICENSE.txt in the package), libraries loaded dynamically: docs/REFERENCE-SOURCES.md. -->
    <PackageVersion Include="FFmpeg.AutoGen" Version="7.1.1" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <!-- Tests (same versions as librespot-dotnet/Directory.Packages.props) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- WebApplicationFactory for the bridge API tests (bridge-service). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Blazor component tests for the web app (web-app; bUnit 2.11.3 targets net10.0, checked on api.nuget.org 2026-10-09). -->
    <PackageVersion Include="bunit" Version="2.11.3" />
  </ItemGroup>
</Project>
