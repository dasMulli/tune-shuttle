<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>Bridge.Web</RootNamespace>
    <Description>Blazor WebAssembly SPA for the bridge: discovery, connect, pairing (transient and PIN), groups, volume, status, diagnostics. Served by Bridge.Service; built by the .NET SDK alone (no node toolchain).</Description>
    <!-- Blazor WASM apps are not documented libraries; keep the doc-file requirement off here. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Keep the defaults (no AOT, no native relinking, no SIMD override): any of those needs the wasm-tools workload. -->
    <!-- Culture-aware formatting (UI-SPEC 3.3): Directory.Build.props turns globalization off for every project; the web
         app needs ICU so 1234.5.ToString("N1") prints 1.234,5 in German. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- All ICU data (icudt.dat), not the shard picked from navigator.language at boot: the user switches to ru/uk at runtime. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <!-- The message catalogs (i18next JSON), embedded so the first render and the bUnit tests have them without HTTP. -->
    <EmbeddedResource Include="Resources\i18n\*.json" LogicalName="Bridge.Web.Resources.i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge.Contracts\Bridge.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog's lookup tests build an I18n over hand-made catalogs (internal constructor). -->
    <InternalsVisibleTo Include="Bridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

</Project>
