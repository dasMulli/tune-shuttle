@* The toasts (UI-SPEC 4.9): API errors and confirmations from BridgeCommands. A fixed region (top right under the
   bar on desktop, above the tab bar on phones); the region is always in the DOM so it is a live region before the
   first toast arrives. It is a plain div with aria-live, not an aside: an always-present complementary landmark without
   a name would be noise in a screen reader's landmark list. Errors are role="alert" (announced at once)
   and stay 15 s, so a forgotten one does not cover the Output rows above the phone tab bar for good; success and info
   toasts go away after 6 s. Every toast can be dismissed earlier. Success and info toasts carry no role of their own:
   the container is their one live region (a role="status" inside it nested a second one, REVIEW cycle 2), and it
   stays aria-live because a status region inserted together with its text is not announced reliably. *@
@inherits BridgeComponentBase

<div class="toasts" aria-live="polite">
    @foreach (var notice in State.Notices)
    {
        <div @key="notice.Id" class="@ClassOf(notice.Kind)" role="@(notice.Kind == NoticeKind.Error ? "alert" : null)">
            <span>@notice.Text</span>
            <button type="button" class="toast__close" aria-label="@L["common.dismiss"]" title="@L["common.dismiss"]" @onclick="() => State.Dismiss(notice.Id)"><span aria-hidden="true">×</span></button>
        </div>
    }
</div>

@code {
    /// <summary>How long success and info notices stay (the default of <see cref="DismissAfter"/>).</summary>
    public static readonly TimeSpan AutoDismiss = TimeSpan.FromSeconds(6);

    /// <summary>How long error notices stay (the default of <see cref="ErrorDismissAfter"/>).</summary>
    public static readonly TimeSpan ErrorAutoDismiss = TimeSpan.FromSeconds(15);

    /// <summary>How long success and info notices stay. Tests shorten it.</summary>
    [Parameter]
    public TimeSpan DismissAfter { get; set; } = AutoDismiss;

    /// <summary>How long error notices stay (longer than the others, so they can be read). Tests shorten it.</summary>
    [Parameter]
    public TimeSpan ErrorDismissAfter { get; set; } = ErrorAutoDismiss;

    private readonly HashSet<long> _scheduled = [];

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        foreach (var notice in State.Notices)
        {
            if (_scheduled.Add(notice.Id))
            {
                var delay = notice.Kind == NoticeKind.Error ? ErrorDismissAfter : DismissAfter;
                Observe(DismissLaterAsync(notice.Id, delay, Lifetime));
            }
        }
    }

    private static string ClassOf(NoticeKind kind) => kind switch
    {
        NoticeKind.Error => "toast toast--err",
        NoticeKind.Success => "toast toast--ok",
        _ => "toast toast--info",
    };

    private async Task DismissLaterAsync(long id, TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // Back on the renderer's context: _scheduled is also read by OnAfterRender.
        await InvokeAsync(() =>
        {
            _scheduled.Remove(id);
            State.Dismiss(id);
        });
    }
}
