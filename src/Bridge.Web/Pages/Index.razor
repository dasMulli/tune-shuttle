@page "/"
@inject BridgeApiClient Api

<PageTitle>Receivers</PageTitle>

<h1>Receivers</h1>

@if (_status is null)
{
    <p>Connecting to the bridge...</p>
}
else
{
    <p>Bridge @_status.Version, Spotify device "@_status.DeviceName", @(_status.SpotifyConnected ? "connected" : "not connected") to Spotify.</p>
}

@* TODO(impl: web-app): receiver list with connect/disconnect, pairing dialog (PIN), per-receiver volume; live updates over /ws/events *@

@code {
    private StatusDto? _status;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await Api.GetStatusAsync(CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            _status = null;
        }
    }
}
