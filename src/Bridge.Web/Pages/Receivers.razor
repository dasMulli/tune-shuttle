@page "/receivers"
@using System.Globalization
@inherits BridgeComponentBase

@* The Receivers page (UI-SPEC 4.4): one card per receiver in an auto-fill grid (one column on phones, two from 700px,
   three at 1280px), each with its state pill, the hero volume slider, the capability/pairing/group/output chips, the
   connect/pair actions and a collapsed <details> holding the offset form and the raw facts. Every text comes from the
   catalog; receiver names, models, addresses and errors are service text (UI-SPEC 3.5). *@

<PageTitle>@L.Format("app.pageTitle", ("page", L["nav.receivers"]))</PageTitle>

<div class="stack">
    <h1>@L["receivers.title"]</h1>

    @if (State.Status is { } status)
    {
        <p class="meta">@Lead(status)</p>
    }

    @if (!State.Loaded)
    {
        <p class="meta" role="status">@L["common.connecting"]</p>
    }
    else if (State.Receivers.Count == 0)
    {
        <div class="empty">
            <strong>@L["receivers.empty"]</strong>
            <span>@L["receivers.emptyHint"]</span>
        </div>
    }
    else
    {
        <div class="cards">
            @foreach (var receiver in State.Receivers)
            {
                var busy = _busy.Contains(receiver.Id);
                var ariaBusy = busy ? "true" : null;
                var inOutput = State.IsInOutput(receiver.Id);
                var session = receiver.State is ReceiverConnectionState.Connected or ReceiverConnectionState.Streaming or ReceiverConnectionState.Connecting;
                var headingId = "receiver-" + Slug(receiver.Id);
                <article class="card receiver" data-receiver-id="@receiver.Id" aria-labelledby="@headingId" @key="receiver.Id">
                    <div class="card__head">
                        <h2 id="@headingId">@receiver.Name</h2>
                        <StatePill Receiver="receiver" />
                    </div>

                    <p class="meta">@Meta(receiver)</p>

                    <div class="field">
                        <span class="label">@L["receivers.volume"]</span>
                        <LevelSlider Variant="LevelSlider.LevelVariant.Hero" HideLabel="true"
                                     Label="@L.Format("receivers.volumeOf", ("name", receiver.Name))"
                                     ValueText="@LevelText" Value="State.LevelOf(receiver)"
                                     Send="(level, ct) => Commands.SetReceiverLevelAsync(receiver.Id, level, ct)" />
                    </div>

                    <div class="tags">
                        @if (receiver.Capabilities.AirPlay2)
                        {
                            <span class="chip">@L["receivers.tags.airplay2"]</span>
                        }
                        @if (receiver.Capabilities.Ptp)
                        {
                            <span class="chip">@L["receivers.tags.ptp"]</span>
                        }
                        @if (receiver.Capabilities.Buffered)
                        {
                            <span class="chip">@L["receivers.tags.buffered"]</span>
                        }
                        @switch (receiver.Pairing)
                        {
                            case PairingState.Paired:
                                <span class="chip chip--accent" data-pairing="paired" title="@L["pills.title.paired"]">@L["pills.paired"]</span>
                                break;
                            case PairingState.PinRequired:
                                <span class="chip chip--warn" data-pairing="pin" title="@L["pills.title.pinNeeded"]">@L["pills.pinNeeded"]</span>
                                break;
                            case PairingState.Disabled:
                                <span class="chip" data-pairing="homekit" title="@L["pills.title.homekitOnly"]">@L["pills.homekitOnly"]</span>
                                break;
                            default:
                                <span class="chip" data-pairing="transient" title="@L["pills.title.noPin"]">@L["pills.noPin"]</span>
                                break;
                        }
                        @if (receiver.GroupId is { } groupId && State.Group(groupId) is { } group)
                        {
                            <span class="chip" data-tag="group">@L.Format("receivers.tags.group", ("name", group.Name))</span>
                        }
                        @if (inOutput)
                        {
                            <span class="chip chip--accent" data-tag="output">@L["receivers.tags.output"]</span>
                        }
                    </div>

                    @if (receiver.Error is { } error && receiver.State == ReceiverConnectionState.Error)
                    {
                        <p class="meta text-err" role="alert">@error</p>
                    }

                    @* While a request runs the buttons are aria-disabled, not disabled (Chromium blurs a focused button that
                       becomes disabled); disabled stays for the static reasons (offline, HomeKit only). Connect and
                       Disconnect are one element whose role switches, so the focus survives the session starting. *@
                    <div class="actions">
                        <button type="button" class="@(session ? "btn" : "btn btn--primary")" data-action="@(session ? "disconnect" : "connect")"
                                disabled="@(!session && (!receiver.Online || receiver.Pairing == PairingState.Disabled))"
                                aria-disabled="@ariaBusy" aria-busy="@ariaBusy"
                                title="@(session ? null : ConnectTitle(receiver))" @ref="_connectButtons[receiver.Id]"
                                @onclick="() => session ? DisconnectAsync(receiver.Id) : ConnectAsync(receiver.Id)">@(session ? L["receivers.disconnect"] : busy ? L["receivers.connecting"] : L["receivers.connect"])</button>

                        @if (receiver.Pairing == PairingState.PinRequired)
                        {
                            <button type="button" class="btn" data-action="pair" disabled="@(!receiver.Online)" aria-disabled="@ariaBusy"
                                    @onclick="() => PairAsync(receiver.Id)">@L["receivers.pairWithPin"]</button>
                        }
                        else if (receiver.Pairing == PairingState.Paired)
                        {
                            <button type="button" class="btn btn--ghost" data-action="forget" aria-disabled="@ariaBusy"
                                    @onclick="() => ForgetAsync(receiver.Id)">@L["receivers.forgetPairing"]</button>
                        }
                    </div>

                    <details class="details">
                        <summary>@L["receivers.details"]</summary>
                        @{
                            var draft = OffsetDraft(receiver);
                            var inputId = "offset-" + Slug(receiver.Id);
                            var hintId = inputId + "-hint";
                            var hasError = _offsetErrors.TryGetValue(receiver.Id, out var offsetError);
                            var errorId = inputId + "-error";
                        }
                        @* novalidate: the browser's own constraint bubble (in the browser's language) would block the
                           submit; the catalog texts receivers.offsetInvalid / receivers.offsetRange are shown instead. *@
                        <form class="offset" novalidate @onsubmit="() => ApplyOffsetAsync(receiver)" @onsubmit:preventDefault>
                            <label for="@inputId" class="label">@L["receivers.offset"]</label>
                            <input id="@inputId" type="number" class="input input--narrow"
                                   step="1" min="@(-MaxOffsetFrames)" max="@MaxOffsetFrames"
                                   value="@draft.ToString(CultureInfo.InvariantCulture)"
                                   aria-invalid="@(hasError ? "true" : null)"
                                   aria-describedby="@(hasError ? hintId + " " + errorId : hintId)"
                                   @onchange="e => SetOffsetDraft(receiver.Id, e)" />
                            @* aria-disabled while unchanged or busy: a successful apply makes the draft equal again, and a
                               disabled button would drop the focus; ApplyOffsetAsync ignores the submit then. *@
                            <button type="submit" class="btn btn--sm" aria-disabled="@(busy || draft == receiver.OffsetFrames ? "true" : null)">@L["receivers.apply"]</button>
                        </form>
                        <p id="@hintId" class="hint">@L.Format("receivers.offsetHint", ("frames", Format.Integer(draft)), ("ms", Format.Milliseconds(draft)))</p>
                        @if (hasError)
                        {
                            <p id="@errorId" class="validation-message" role="alert">@(offsetError == OffsetError.Invalid ? L["receivers.offsetInvalid"] : L.Format("receivers.offsetRange", ("max", Format.Integer(MaxOffsetFrames))))</p>
                        }
                        <dl class="facts">
                            <dt>@L["receivers.facts.id"]</dt>
                            <dd class="mono">@receiver.Id</dd>
                            <dt>@L["receivers.facts.manufacturer"]</dt>
                            <dd>@(receiver.Manufacturer ?? Dash)</dd>
                            <dt>@L["receivers.facts.port"]</dt>
                            <dd class="mono">@receiver.Port.ToString(CultureInfo.InvariantCulture)</dd>
                            <dt>@L["receivers.facts.features"]</dt>
                            <dd class="mono">@receiver.Capabilities.Features</dd>
                            <dt>@L["receivers.facts.flags"]</dt>
                            <dd class="mono">@receiver.Capabilities.Flags</dd>
                        </dl>
                    </details>
                </article>
            }
        </div>
    }
</div>

@code {
    /// <summary>Largest offset the service accepts (2 s at 44.1 kHz, SPEC-audio.md 3.3).</summary>
    public const int MaxOffsetFrames = 88200;

    /// <summary>Shown for a missing value (a glyph, not catalog text).</summary>
    private const string Dash = "–";

    private readonly HashSet<string> _busy = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _offsetDrafts = new(StringComparer.Ordinal);

    // Pair and Forget pairing swap each other when the pairing state changes, so the pressed button goes away: the focus
    // moves to the row's Connect / Disconnect button (one element in both states) instead of dropping to <body>. A Pair
    // opens the dialog first; its row is remembered until the dialog closes (focus never moves behind the open modal).
    private readonly Dictionary<string, ElementReference> _connectButtons = new(StringComparer.Ordinal);
    private string? _pairingFor;
    private string? _focusConnectOf;

    /// <summary>The Connect / Disconnect button of a receiver's card (tests: the focus target after Pair / Forget).</summary>
    internal ElementReference ConnectButtonOf(string receiverId) => _connectButtons[receiverId];
    // What went wrong, not its text: the message is rendered in the current language (a language switch re-renders).
    private readonly Dictionary<string, OffsetError> _offsetErrors = new(StringComparer.Ordinal);

    private enum OffsetError
    {
        Invalid,
        Range,
    }

    private string LevelText(int value) => L.Format("common.levelText", ("value", value));

    /// <summary>"Spotify device {{device}}, {{spotify}}. {{output}}" (receivers.lead).</summary>
    private string Lead(StatusDto status)
    {
        var spotify = status.SpotifyConnected
            ? status.SpotifyUser is { Length: > 0 } user
                ? L.Format("receivers.leadSpotifyConnected", ("user", user))
                : L["receivers.leadSpotifyConnectedNoUser"]
            : L["receivers.leadSpotifyNotConnected"];
        var output = State.Output;
        var outputText = output.GroupId is { } groupId
            ? L.Format("receivers.leadOutputGroup", ("name", State.Group(groupId)?.Name ?? groupId))
            : output.ReceiverId is { } receiverId
                ? L.Format("receivers.leadOutputReceiver", ("name", State.NameOf(receiverId)))
                : L["receivers.leadOutputNone"];
        return L.Format("receivers.lead", ("device", status.DeviceName), ("spotify", spotify), ("output", outputText));
    }

    /// <summary>player.receiverMeta ("{{model}} · {{address}}") with the address as "address:port"; only the model while the receiver has no address.</summary>
    private string Meta(ReceiverDto receiver)
    {
        var model = string.IsNullOrWhiteSpace(receiver.Model) ? L["receivers.unknownModel"] : receiver.Model;
        return receiver.Address is { Length: > 0 } address
            ? L.Format("player.receiverMeta", ("model", model), ("address", address + ":" + receiver.Port.ToString(CultureInfo.InvariantCulture)))
            : model;
    }

    /// <summary>
    /// The Connect button's title: receivers.offlineTitle while it is disabled because the receiver is offline, the
    /// HomeKit explanation while pairing is disabled, receivers.connectTitle otherwise.
    /// </summary>
    private string ConnectTitle(ReceiverDto receiver)
    {
        if (!receiver.Online)
        {
            return L["receivers.offlineTitle"];
        }

        return receiver.Pairing == PairingState.Disabled ? L["pills.title.homekitOnly"] : L["receivers.connectTitle"];
    }

    /// <summary>An id fragment for element ids (receiver ids are MAC-like, "02:FA:CE:00:00:01").</summary>
    private static string Slug(string id)
    {
        var chars = id.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            if (!char.IsAsciiLetterOrDigit(chars[i]))
            {
                chars[i] = '-';
            }
        }

        return new string(chars);
    }

    private int OffsetDraft(ReceiverDto receiver) => _offsetDrafts.TryGetValue(receiver.Id, out var draft) ? draft : receiver.OffsetFrames;

    private void SetOffsetDraft(string receiverId, ChangeEventArgs e)
    {
        _offsetErrors.Remove(receiverId);
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var frames))
        {
            _offsetDrafts[receiverId] = frames;
        }
        else
        {
            _offsetErrors[receiverId] = OffsetError.Invalid;
        }
    }

    private async Task ApplyOffsetAsync(ReceiverDto receiver)
    {
        if (_offsetErrors.ContainsKey(receiver.Id))
        {
            return;
        }

        var frames = OffsetDraft(receiver);
        if (frames == receiver.OffsetFrames)
        {
            return; // nothing to apply (the button is aria-disabled)
        }

        if (Math.Abs(frames) > MaxOffsetFrames)
        {
            _offsetErrors[receiver.Id] = OffsetError.Range;
            return;
        }

        await RunAsync(receiver.Id, async ct =>
        {
            if (await Commands.SetOffsetAsync(receiver.Id, frames, ct))
            {
                _offsetDrafts.Remove(receiver.Id);
            }
        });
    }

    private Task ConnectAsync(string id) => RunAsync(id, ct => Commands.ConnectAsync(id, ct));

    private Task DisconnectAsync(string id) => RunAsync(id, ct => Commands.DisconnectAsync(id, ct));

    private Task PairAsync(string id) => RunAsync(id, async ct =>
    {
        if (await Commands.StartPairingAsync(id, ct))
        {
            _pairingFor = id;
        }
    });

    private Task ForgetAsync(string id) => RunAsync(id, async ct =>
    {
        if (await Commands.ForgetPairingAsync(id, ct))
        {
            _focusConnectOf = id;
        }
    });

    /// <inheritdoc />
    protected override void OnBridgeStateChanged()
    {
        if (_pairingFor is { } id && State.Pairing is null)
        {
            // The dialog closed: paired (the Pair button became Forget) or cancelled (the dialog restores the focus).
            _pairingFor = null;
            if (State.Receiver(id) is { Pairing: not PairingState.PinRequired })
            {
                _focusConnectOf = id;
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusConnectOf is not { } id)
        {
            return;
        }

        _focusConnectOf = null;
        if (!_connectButtons.TryGetValue(id, out var button) || button.Context is null)
        {
            return;
        }

        try
        {
            await button.FocusAsync();
        }
        catch (JSException)
        {
            // the element went away between the render and the call
        }
        catch (JSDisconnectedException)
        {
            // the page is going away
        }
    }

    private async Task RunAsync(string id, Func<CancellationToken, Task> action)
    {
        if (!_busy.Add(id))
        {
            return;
        }

        try
        {
            await action(Lifetime);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested)
        {
            // the page went away
        }
        finally
        {
            _busy.Remove(id);
        }
    }
}
