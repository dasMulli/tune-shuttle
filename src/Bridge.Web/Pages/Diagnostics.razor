@page "/settings/diagnostics"
@inherits BridgeComponentBase
@using Microsoft.Extensions.Logging
@inject BridgeEventClient Events

@* UI-SPEC 4.7: back link, then a grid of four fact cards (the fourth the AirPlay receiver, SPEC-receiver.md 9.2) and the full-width live log. Values that originate in the
   service (version, device and receiver names, addresses, probe names, log lines) are shown as sent (3.5). *@

<PageTitle>@L.Format("app.pageTitle", ("page", L["nav.diagnostics"]))</PageTitle>

<div class="stack">
    <div>
        <a class="btn btn--ghost btn--back" href="settings"><span aria-hidden="true">←</span> @L["nav.backToSettings"]</a>
    </div>
    <h1>@L["diagnostics.title"]</h1>

    <div class="cards">
        <section class="card" aria-labelledby="diagnostics-status">
            <div class="card__head"><h2 id="diagnostics-status">@L["diagnostics.status"]</h2></div>
            @if (State.Status is { } status)
            {
                <dl class="facts">
                    <dt>@L["diagnostics.version"]</dt><dd>@status.Version</dd>
                    <dt>@L["diagnostics.runningSince"]</dt><dd>@Format.DateTime(status.StartedAt)</dd>
                    <dt>@L["diagnostics.spotify"]</dt><dd>@SpotifyText(status)</dd>
                    <dt>@L["diagnostics.deviceName"]</dt><dd>@status.DeviceName</dd>
                    <dt>@L["diagnostics.output"]</dt><dd>@OutputText()</dd>
                    <dt>@L["diagnostics.receiversOnNetwork"]</dt><dd>@Format.Integer(status.Receivers)</dd>
                    <dt>@L["diagnostics.liveUpdates"]</dt><dd>@LiveUpdatesText()</dd>
                </dl>
            }
            else
            {
                <p class="meta">@L["common.loading"]</p>
            }
        </section>

        <section class="card" aria-labelledby="diagnostics-network">
            <div class="card__head"><h2 id="diagnostics-network" tabindex="-1" @ref="_networkTitle">@L["diagnostics.network"]</h2></div>
            @if (_diagnostics is { } d)
            {
                <dl class="facts">
                    <dt>@L["diagnostics.timingPort"]</dt><dd>@Port(d.TimingPort)</dd>
                    <dt>@L["diagnostics.controlPort"]</dt><dd>@Port(d.ControlPort)</dd>
                    <dt>@L["diagnostics.packetsSent"]</dt><dd>@Format.Integer(d.PacketsSent)</dd>
                    <dt>@L["diagnostics.retransmits"]</dt><dd>@Format.Integer(d.RetransmitRequests)</dd>
                    <dt>@L["diagnostics.lateWakeups"]</dt><dd>@Format.Integer(d.LateWakeups)</dd>
                    <dt>@L["diagnostics.retransmitRatio"]</dt><dd class="retransmit-ratio">@RetransmitRatio(d)</dd>
                    <dt class="facts__wide">@L["diagnostics.localAddresses"]</dt>
                    <dd class="addresses facts__wide">
                        @if (d.LocalAddresses.Count == 0)
                        {
                            @L["diagnostics.noneReported"]
                        }
                        else
                        {
                            var ordered = OrderAddresses(d.LocalAddresses);
                            @foreach (var address in ordered.Take(ShownAddresses))
                            {
                                <div class="mono">@address</div>
                            }
                            @if (ordered.Count > ShownAddresses)
                            {
                                <details class="details">
                                    <summary>@L.Plural("diagnostics.more", ordered.Count - ShownAddresses)</summary>
                                    @foreach (var address in ordered.Skip(ShownAddresses))
                                    {
                                        <div class="mono">@address</div>
                                    }
                                </details>
                            }
                        }
                    </dd>
                </dl>
                @if (_error is not null)
                {
                    <p class="meta text-err" role="alert">@L.Format("diagnostics.unavailable", ("detail", BridgeCommands.Describe(_error, L)))</p>
                }
                @if (_updated is { } updated)
                {
                    <p class="meta">@L.Format("diagnostics.updated", ("time", Format.Time(updated)))</p>
                }
            }
            else if (_error is not null)
            {
                <p class="meta text-err" role="alert">@L.Format("diagnostics.unavailable", ("detail", BridgeCommands.Describe(_error, L)))</p>
                <div class="actions">
                    <button type="button" class="btn" @onclick="RetryAsync" @ref="_retryButton">@L["common.retry"]</button>
                </div>
            }
            else
            {
                <p class="meta">@L["common.loading"]</p>
            }
        </section>

        <section class="card" aria-labelledby="diagnostics-probes">
            <div class="card__head"><h2 id="diagnostics-probes">@L["diagnostics.pendingProbes"]</h2></div>
            @if (_diagnostics is { OpenQuestionsPending.Count: > 0 } pending)
            {
                @foreach (var probe in pending.OpenQuestionsPending)
                {
                    <p class="meta probe">@probe</p>
                }
            }
            else if (_diagnostics is not null)
            {
                <p class="meta">@L["diagnostics.noneReported"]</p>
            }
            else
            {
                <p class="meta">@L["common.loading"]</p>
            }
        </section>

        @* SPEC-receiver.md 9.2: the AirPlay receiver from StatusDto.Airplay (state, sender; live through the status events)
           and DiagnosticsDto.Airplay (stream, buffer, counters, PTP, decoder; the 5 s refresh), in the spec's order: state,
           sender, the four value lines (.meta, like the probes card), decoder. Loading until the status snapshot arrives (a
           failed diagnostics request shows its error on the Network card); without the receiver part of the status it reads
           as off, and without the diagnostics part the four lines are one dash instead of templates full of dashes. *@
        <section class="card" aria-labelledby="diagnostics-airplay">
            <div class="card__head"><h2 id="diagnostics-airplay">@L["diagnostics.airplay"]</h2></div>
            @if (State.Status is not { } airplayStatus)
            {
                <p class="meta">@L["common.loading"]</p>
            }
            else
            {
                var receiver = airplayStatus.Airplay;
                var airplay = _diagnostics?.Airplay;
                <dl class="facts">
                    <dt>@L["diagnostics.airplayState"]</dt><dd class="airplay-state">@AirplayStateWord(receiver?.State)</dd>
                    <dt>@L["diagnostics.airplaySender"]</dt><dd class="airplay-sender">@OrDash(receiver?.SenderName)</dd>
                </dl>
                @if (airplay is not null)
                {
                    <p class="meta airplay-stream">@L.Format("diagnostics.airplayStream", ("type", OrDash(airplay.StreamType)), ("format", OrDash(airplay.Format)))</p>
                    <p class="meta airplay-buffer">@L.Format("diagnostics.airplayBuffer", ("ms", Format.Integer(airplay.BufferedMs)), ("offset", Format.Integer(airplay.StreamOffsetMs)))</p>
                    <p class="meta airplay-late">@L.Format("diagnostics.airplayLate", ("late", Format.Integer(airplay.LateFrames)), ("missing", Format.Integer(airplay.MissingFrames)), ("drift", Format.Integer(airplay.DriftCorrections)))</p>
                    <p class="meta airplay-ptp">@PtpText(airplay)</p>
                }
                else
                {
                    <p class="meta airplay-none">@NoValue</p>
                }
                <dl class="facts">
                    <dt>@L["diagnostics.airplayDecoder"]</dt><dd class="airplay-decoder">@OrDash(airplay?.DecoderStatus)</dd>
                </dl>
            }
        </section>

        <section class="card card--wide" aria-labelledby="diagnostics-log">
            <div class="card__head">
                <h2 id="diagnostics-log">@L["diagnostics.log"]</h2>
                <div class="card__actions">
                    <div class="field field--inline">
                        <label for="log-level">@L["diagnostics.level"]</label>
                        <select id="log-level" class="input input--sm" @bind="_minimumLevel">
                            <option value="0">@L["diagnostics.levels.all"]</option>
                            <option value="2">@L["diagnostics.levels.info"]</option>
                            <option value="3">@L["diagnostics.levels.warning"]</option>
                            <option value="4">@L["diagnostics.levels.error"]</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn--ghost btn--sm log-pause" @onclick="TogglePause">
                        @(_paused ? L["diagnostics.resume"] : L["diagnostics.pause"])
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm log-clear" @onclick="Clear">@L["diagnostics.clear"]</button>
                </div>
            </div>
            @{
                var lines = Lines();
            }
            @if (lines.Count == 0)
            {
                <p class="meta">@L["diagnostics.noLines"]</p>
            }
            else
            {
                @* aria-live="off": role=log is an implicit polite live region, and debug traffic (plus the replay after a
                   reconnect) would flood a screen reader; the focusable log is read on demand. @key keeps the <p> of a
                   line when lines are appended and the oldest drop out. *@
                <div class="log" role="log" aria-live="off" tabindex="0" aria-labelledby="diagnostics-log">
                    @foreach (var line in lines)
                    {
                        <p @key="line.Key" class="@LineClass(line.Level)">@line.Text</p>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    /// <summary>How often the statistics refresh.</summary>
    public static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    /// <summary>Addresses listed before the rest is folded away (UI-SPEC 4.7: the first five).</summary>
    public const int ShownAddresses = 5;

    /// <summary>The value shown while a ratio has no denominator (U+2013).</summary>
    public const string NoValue = "–";

    private DiagnosticsDto? _diagnostics;
    private DateTimeOffset? _updated;
    private Exception? _error; // kept, not its text: described in the current language per render
    private int _minimumLevel;
    private bool _paused;
    private bool _historyCleared;
    private IReadOnlyList<ShownLine>? _pausedView;
    private bool _subscribed;

    // After Retry the facts (or the "loading" line in between) replace the pressed button: the focus goes to the card's
    // heading on success and back to the new Retry button on another failure, never to <body>.
    private bool _focusTitle;
    private bool _focusRetry;
    private ElementReference _networkTitle;
    private ElementReference _retryButton;

    // The page re-renders on every state change, most of which are not log lines: the formatted text of each live line
    // is kept, and the lists are rebuilt only when the log (BridgeState.LogVersion), the REST history or the filter
    // changed. The lists are never mutated, so a paused snapshot can share them.
    private Dictionary<BridgeEvent.LogLine, string> _formatted = [];
    private long _liveVersion = -1;
    private IReadOnlyList<ShownLine> _live = [];
    private DiagnosticsDto? _historyOf;
    private IReadOnlyList<ShownLine> _history = [];
    private IReadOnlyList<ShownLine>? _filteredOf;
    private int _filteredLevel;
    private IReadOnlyList<ShownLine> _filtered = [];

    /// <summary>Live lines formatted so far (each once, not once per render; tests).</summary>
    internal int FormattedLines { get; private set; }

    /// <summary>
    /// A log line as shown: its level (for the class and the filter), its text and the <c>@key</c> of its element (the
    /// live <see cref="BridgeEvent.LogLine"/> itself, or the history text).
    /// </summary>
    private readonly record struct ShownLine(string Level, string Text, object Key);

    /// <summary>
    /// Severity rank of a log level name: the service writes the console's short forms (trce, dbug, info, warn, fail,
    /// crit; Bridge.Service LogBuffer.LevelName); the full Microsoft.Extensions.Logging names are accepted as well.
    /// </summary>
    public static int Rank(string level) => level.ToLowerInvariant() switch
    {
        "trce" or "trace" => 0,
        "dbug" or "debug" => 1,
        "info" or "information" => 2,
        "warn" or "warning" => 3,
        "fail" or "error" => 4,
        "crit" or "critical" => 5,
        _ => 2,
    };

    /// <summary>The <c>.log__line</c> classes of a level (UI-SPEC 1.5), by its <see cref="Rank"/>.</summary>
    public static string LineClass(string level) => Rank(level) switch
    {
        0 => "log__line log__line--trce",
        1 => "log__line log__line--dbug",
        3 => "log__line log__line--warn",
        4 => "log__line log__line--fail",
        5 => "log__line log__line--crit",
        _ => "log__line",
    };

    /// <summary>
    /// IPv4 first (what receivers on a home LAN use), then the rest in the service's order. Entries read
    /// "interface: address" (Bridge.Service BridgeController.LocalAddresses); one that does not parse goes last.
    /// </summary>
    public static IReadOnlyList<string> OrderAddresses(IReadOnlyList<string> addresses) =>
        [.. addresses.OrderBy(AddressRank)];

    private static int AddressRank(string entry)
    {
        var separator = entry.LastIndexOf(": ", StringComparison.Ordinal);
        var address = separator < 0 ? entry : entry[(separator + 2)..];
        if (!System.Net.IPAddress.TryParse(address, out var parsed))
        {
            return 2;
        }

        return parsed.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork ? 0 : 1;
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _subscribed = true;
        await Events.SetLogSubscriptionAsync(true, Lifetime);
        await RefreshAsync(Lifetime);
        Every(RefreshInterval, async ct =>
        {
            await RefreshAsync(ct);
            await InvokeAsync(StateHasChanged);
        });
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        if (disposing && _subscribed)
        {
            _subscribed = false;
            Observe(Events.SetLogSubscriptionAsync(false, CancellationToken.None));
        }
    }

    private string Port(int port) => port == 0 ? L["diagnostics.notBound"] : port.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string SpotifyText(StatusDto status) => status switch
    {
        { SpotifyConnected: true, SpotifyUser: { Length: > 0 } user } => L.Format("diagnostics.spotifyConnectedAs", ("user", user)),
        { SpotifyConnected: true } => L["diagnostics.connected"],
        _ => L["diagnostics.notConnected"],
    };

    private string OutputText()
    {
        var output = State.Output;
        if (output.GroupId is { } groupId)
        {
            return State.Group(groupId)?.Name ?? groupId;
        }

        return output.ReceiverId is { } receiverId ? State.NameOf(receiverId) : L["common.none"];
    }

    /// <summary>The word of the live pill (UI-SPEC 7) for the event connection, by the pill's own mapping.</summary>
    private string ConnectionWord() => StatusPill.KindOf(State) switch
    {
        StatusPill.Kind.Live => L["status.live"],
        StatusPill.Kind.Connecting => L["status.connecting"],
        StatusPill.Kind.Paused => L["status.paused"],
        _ => L["status.offline"],
    };

    private string LiveUpdatesText() => L.Plural(
        "diagnostics.liveUpdatesValue",
        Events.Connections,
        ("state", ConnectionWord()),
        ("events", Format.Integer(Events.EventsReceived)));

    private string RetransmitRatio(DiagnosticsDto d) => d.PacketsSent == 0
        ? NoValue
        : L.Format(
            "diagnostics.retransmitRatioValue",
            ("percent", Format.Percent(d.RetransmitRequests / (double)d.PacketsSent, 1)),
            ("late", Format.Integer(d.LateWakeups)));

    /// <summary>The digits of the PTP offset in milliseconds (SPEC-receiver.md 9.2: nanoseconds shown as ms, to the microsecond).</summary>
    public const int PtpOffsetDigits = 3;

    /// <summary>A service text, or <see cref="NoValue"/> when it is absent or empty (SPEC-receiver.md 9.2).</summary>
    private static string OrDash(string? text) => string.IsNullOrEmpty(text) ? NoValue : text;

    /// <summary>
    /// The state word of the receiver (SPEC-receiver.md 9.1, 9.2: diagnostics.airplayStates.*): off without the status part,
    /// a state this build does not know as sent (UI-SPEC 3.5).
    /// </summary>
    private string AirplayStateWord(string? state) => state switch
    {
        null or "off" => L["diagnostics.airplayStates.off"],
        "starting" => L["diagnostics.airplayStates.starting"],
        "advertising" => L["diagnostics.airplayStates.advertising"],
        "connected" => L["diagnostics.airplayStates.connected"],
        "streaming" => L["diagnostics.airplayStates.streaming"],
        "error" => L["diagnostics.airplayStates.error"],
        _ => state,
    };

    /// <summary>
    /// The PTP line (SPEC-receiver.md 9.2, R5): diagnostics.airplayPtpNotBound in anchor-only timing, else the slave's offset
    /// in milliseconds, a dash while there is no estimate.
    /// </summary>
    private string PtpText(AirplayDiagnosticsDto airplay) => airplay.PtpBound
        ? L.Format("diagnostics.airplayPtp", ("ms", airplay.PtpOffsetNs is { } ns ? SignedMilliseconds(ns) : NoValue))
        : L["diagnostics.airplayPtpNotBound"];

    /// <summary>
    /// Nanoseconds as milliseconds with <see cref="PtpOffsetDigits"/> digits in the culture, a negative value with
    /// <see cref="Format.Minus"/> (U+2212, UI-SPEC 10) rather than the culture's hyphen (SPEC-receiver.md 9.2).
    /// </summary>
    internal static string SignedMilliseconds(long ns)
    {
        var magnitude = Format.Decimal(Math.Abs(ns / 1_000_000.0), PtpOffsetDigits);
        return ns < 0 && magnitude.Any(c => c is >= '1' and <= '9') ? Format.Minus + magnitude : magnitude;
    }

    private void Clear()
    {
        _historyCleared = true;
        _pausedView = _paused ? [] : null;
        State.ClearLog();
    }

    /// <summary>
    /// Pausing takes a snapshot of what is shown (live lines or the REST history), so neither new live lines nor the
    /// periodic refresh change it until resume; resuming drops the snapshot and catches up.
    /// </summary>
    private void TogglePause()
    {
        _paused = !_paused;
        _pausedView = _paused ? CurrentLines() : null;
    }

    /// <summary>The paused snapshot or the current lines, filtered by the chosen minimum level.</summary>
    private IReadOnlyList<ShownLine> Lines()
    {
        var lines = _pausedView ?? CurrentLines();
        if (_minimumLevel == 0)
        {
            return lines;
        }

        if (!ReferenceEquals(lines, _filteredOf) || _minimumLevel != _filteredLevel)
        {
            _filtered = [.. lines.Where(l => Rank(l.Level) >= _minimumLevel)];
            _filteredOf = lines;
            _filteredLevel = _minimumLevel;
        }

        return _filtered;
    }

    /// <summary>
    /// The live lines, or the service's recent history from the REST answer until the first live line arrives (and
    /// not again after Clear); unfiltered.
    /// </summary>
    private IReadOnlyList<ShownLine> CurrentLines()
    {
        // The version first: a line appended after this read makes the next render rebuild again.
        var version = State.LogVersion;
        if (version != _liveVersion)
        {
            var live = State.Log;
            var formatted = new Dictionary<BridgeEvent.LogLine, string>(live.Count);
            var lines = new ShownLine[live.Count];
            for (var i = 0; i < live.Count; i++)
            {
                var line = live[i];
                if (!_formatted.TryGetValue(line, out var text))
                {
                    text = $"{line.At.ToLocalTime().ToString("HH:mm:ss.fff", System.Globalization.CultureInfo.InvariantCulture)} {line.Level} {line.Category}: {line.Message}";
                    FormattedLines++;
                }

                formatted[line] = text;
                lines[i] = new ShownLine(line.Level, text, line);
            }

            _formatted = formatted; // lines that dropped out of the log are forgotten
            _live = lines;
            _liveVersion = version;
        }

        if (_live.Count > 0 || _historyCleared || _diagnostics is null)
        {
            return _live;
        }

        if (!ReferenceEquals(_diagnostics, _historyOf))
        {
            // History lines are plain text and may repeat: the n-th repeat of a text gets (text, n) as its key.
            var seen = new Dictionary<string, int>(StringComparer.Ordinal);
            _history = [.. _diagnostics.RecentLog.Select(text =>
            {
                var n = seen[text] = seen.GetValueOrDefault(text) + 1;
                return new ShownLine(HistoryLevel(text), text, n == 1 ? text : (text, n));
            })];
            _historyOf = _diagnostics;
        }

        return _history;
    }

    /// <summary>The level of a history line "HH:mm:ss.fff level Category: message" (info when it does not parse).</summary>
    private static string HistoryLevel(string text)
    {
        var parts = text.Split(' ', 3, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? parts[1] : string.Empty;
    }

    private async Task RetryAsync()
    {
        _error = null;
        await RefreshAsync(Lifetime);
        _focusTitle = _diagnostics is not null;
        _focusRetry = _diagnostics is null && _error is not null;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The Retry button of the next render is a new element: its reference is known only after that render.
        if (!_focusTitle && !_focusRetry)
        {
            return;
        }

        var target = _focusTitle ? _networkTitle : _retryButton;
        _focusTitle = false;
        _focusRetry = false;
        if (target.Context is null)
        {
            return;
        }

        try
        {
            await target.FocusAsync();
        }
        catch (JSException)
        {
            // the element went away between the render and the call
        }
        catch (JSDisconnectedException)
        {
            // the page is going away
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            _diagnostics = await Commands.Api.GetDiagnosticsAsync(ct);
            _updated = DateTimeOffset.Now;
            _error = null;
        }
        catch (Exception ex) when (BridgeCommands.IsFailure(ex, ct))
        {
            // A timeout included: the page shows the catalog text, and a failed tick does not end the refresh loop.
            if (_error is null)
            {
                // Once per outage, not on every refresh tick.
                LoggerFactory.CreateLogger<Diagnostics>().LogWarning("Loading the diagnostics failed: {Error}", ex.Message);
            }

            _error = ex;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // the page went away
        }
    }
}
