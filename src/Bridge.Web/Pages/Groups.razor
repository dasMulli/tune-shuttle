@page "/groups"
@inherits BridgeComponentBase

@* The group list (UI-SPEC 4.5): back link to the Player, the G / r_i explanation, "New group", then one row per group
   (name, member names, state pill, Edit). Creating, editing and deleting happen in Pages/GroupEditor. Group and
   receiver names are service text (UI-SPEC 3.5). *@

<PageTitle>@L.Format("app.pageTitle", ("page", L["nav.groups"]))</PageTitle>

<div class="stack stack--narrow">
    <div>
        <a class="btn btn--ghost" href="./"><span aria-hidden="true">←</span> @L["nav.backToPlayer"]</a>
    </div>
    <h1>@L["groups.title"]</h1>
    <p class="meta">@L["groups.lead"]</p>
    <div>
        <a class="btn btn--primary" href="groups/new">@L["groups.newGroup"]</a>
    </div>

    @if (!State.Loaded)
    {
        <p class="meta" role="status">@L["common.connecting"]</p>
    }
    else if (State.Groups.Count == 0)
    {
        <div class="empty">
            <p>@L["groups.empty"]</p>
        </div>
    }
    else
    {
        @* The rows sit in a plain block inside the card, so the card's flex gap does not split them. *@
        <div class="card">
            <div>
            @foreach (var group in State.Groups)
            {
                <div class="row" data-group-id="@group.Id" @key="group.Id">
                    <span class="row__main">
                        <strong>@group.Name</strong>
                        <span class="meta">@Members(group)</span>
                    </span>
                    <StatePill Group="group" />
                    <a class="btn btn--sm" href="@("groups/" + Uri.EscapeDataString(group.Id))"
                       aria-label="@L.Format("player.editGroup", ("name", group.Name))">@L["groups.edit"]</a>
                </div>
            }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The member names joined by ", " (the receiver's current name when it is known), or groups.noMembers.</summary>
    private string Members(GroupDto group) => group.Members.Count == 0
        ? L["groups.noMembers"]
        : string.Join(", ", group.Members.Select(m => State.Receiver(m.ReceiverId)?.Name ?? m.Name));
}
