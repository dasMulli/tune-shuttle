@page "/settings"
@inherits BridgeComponentBase
@inject BrowserBridge Browser

@* UI-SPEC 4.6: one narrow column of four cards (Bridge form, Appearance, Spotify, Diagnostics link). *@

<PageTitle>@L.Format("app.pageTitle", ("page", L["nav.settings"]))</PageTitle>

<div class="stack stack--narrow">
    <h1>@L["settings.title"]</h1>

    @if (_editContext is null || _model is null)
    {
        <section class="card" aria-labelledby="settings-bridge">
            <div class="card__head"><h2 id="settings-bridge">@L["settings.bridge"]</h2></div>
            @if (_loadError is null)
            {
                <p class="meta">@L["common.loading"]</p>
            }
            else
            {
                <p class="meta text-err" role="alert">@L.Format("settings.loadFailed", ("detail", _loadError))</p>
                <div class="actions">
                    <button type="button" class="btn" @onclick="LoadAsync">@L["common.retry"]</button>
                </div>
            }
        </section>
    }
    else
    {
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="card settings" aria-labelledby="settings-bridge">
            <DataAnnotationsValidator />
            <div class="card__head"><h2 id="settings-bridge">@L["settings.bridge"]</h2></div>
            @if (_loadError is not null)
            {
                @* A failed reload (Reset) while the form is shown: say so above the values it could not replace. *@
                <p class="meta text-err" role="alert">@L.Format("settings.loadFailed", ("detail", _loadError))</p>
                <div class="actions">
                    <button type="button" class="btn settings-retry" @onclick="LoadAsync" disabled="@_saving">@L["common.retry"]</button>
                </div>
            }

            <div class="field">
                <label for="device-name">@L["settings.deviceName"]</label>
                <InputText id="device-name" class="input" @bind-Value="_model.DeviceName" maxlength="64" autocomplete="off" aria-describedby="device-name-hint" />
                <ValidationMessage For="() => _model.DeviceName" role="alert" />
                <p class="hint" id="device-name-hint">@L["settings.deviceNameHint"]</p>
            </div>

            <div class="field">
                <label for="latency">@L["settings.latency"]</label>
                @* InputNumber checks the parse itself, before any attribute runs: an empty field or "1e" stores
                   ParsingErrorMessage. That message is the catalog key (no {0}, so string.Format keeps it as is) and is
                   rendered through L[…] here, so it never shows the C# property name and follows a language switch. The
                   attribute messages are already text (SettingsModel.CatalogMessage) and pass L[…] unchanged. *@
                <InputNumber id="latency" class="input" @bind-Value="_model.LatencyFrames" inputmode="numeric"
                             ParsingErrorMessage="settings.validation.latencyNumber"
                             min="@SettingsModel.MinLatencyFrames" max="@SettingsModel.MaxLatencyFrames" step="441" aria-describedby="latency-hint" />
                @foreach (var message in _editContext.GetValidationMessages(() => _model.LatencyFrames))
                {
                    <div class="validation-message" role="alert">@L[message]</div>
                }
                <p class="hint" id="latency-hint">
                    @L.Format("settings.latencyHint",
                        ("ms", Format.Milliseconds(_model.LatencyFrames)),
                        ("min", Format.Integer(SettingsModel.MinLatencyFrames)),
                        ("max", Format.Integer(SettingsModel.MaxLatencyFrames)))
                    @L["settings.latencyHint2"]
                </p>
            </div>

            <div class="field">
                <label for="stream">@L["settings.stream"]</label>
                <InputSelect id="stream" class="input" @bind-Value="_model.PreferredStream" aria-describedby="stream-hint">
                    <option value="Realtime">@L["settings.streamRealtime"]</option>
                    <option value="Buffered">@L["settings.streamBuffered"]</option>
                </InputSelect>
                <ValidationMessage For="() => _model.PreferredStream" role="alert" />
                <p class="hint" id="stream-hint">@L["settings.streamHint"]</p>
            </div>

            @* Built like the Appearance radios: the label wraps the checkbox and is the whole 44px row on phones (5.4/5.6),
               and both kinds of check rows share one typography. The hint sits under the text column (box + gap). *@
            <div class="field">
                <label class="field--check" for="poll">
                    <InputCheckbox id="poll" @bind-Value="_model.PollReceiverVolume" aria-describedby="poll-hint" />
                    <span>@L["settings.poll"]</span>
                </label>
                <p class="hint hint--check" id="poll-hint">@L["settings.pollHint"]</p>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn--primary" disabled="@_saving">@(_saving ? L["settings.saving"] : L["settings.save"])</button>
                <button type="button" class="btn btn--ghost" @onclick="LoadAsync" disabled="@_saving">@L["settings.reset"]</button>
            </div>
        </EditForm>
    }

    <section class="card" aria-labelledby="settings-appearance">
        <div class="card__head"><h2 id="settings-appearance">@L["settings.appearance"]</h2></div>
        <fieldset class="field">
            <legend>@L["settings.theme"]</legend>
            @* The whole row is the label (it wraps its radio and names it with for=), so the full 44px row is the target. *@
            <label class="field--check" for="settings-theme-light">
                <input id="settings-theme-light" type="radio" name="settings-theme" value="light" checked="@(_theme == Light)" @onchange="() => ChooseThemeAsync(Light)" />
                <span>@L["theme.light"]</span>
            </label>
            <label class="field--check" for="settings-theme-dark">
                <input id="settings-theme-dark" type="radio" name="settings-theme" value="dark" checked="@(_theme == Dark)" @onchange="() => ChooseThemeAsync(Dark)" />
                <span>@L["theme.dark"]</span>
            </label>
            <label class="field--check" for="settings-theme-system">
                <input id="settings-theme-system" type="radio" name="settings-theme" value="system" checked="@(_theme == SystemTheme)" @onchange="() => ChooseThemeAsync(SystemTheme)" />
                <span>@L["theme.system"]</span>
            </label>
        </fieldset>
        <div class="field">
            <label for="settings-language">@L["settings.language"]</label>
            <LanguageSelect Variant="@LanguageSelect.Field" Id="settings-language" />
        </div>
    </section>

    <section class="card" aria-labelledby="settings-spotify">
        <div class="card__head"><h2 id="settings-spotify">@L["settings.spotify"]</h2></div>
        @if (State.Status is { } status)
        {
            <p>@SpotifyLine(status)</p>
        }
        else
        {
            <p class="meta">@L["common.loading"]</p>
        }
        @if (_confirmForget)
        {
            <p>@L["settings.forgetConfirm"]</p>
            <div class="actions">
                <button type="button" class="btn btn--danger" @onclick="ForgetSpotifyAsync" disabled="@_forgetting">@L["settings.forget"]</button>
                <button type="button" class="btn" @onclick="() => _confirmForget = false" disabled="@_forgetting">@L["common.keep"]</button>
            </div>
        }
        else
        {
            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="() => _confirmForget = true">@L["settings.forgetSpotify"]</button>
            </div>
        }
    </section>

    <section class="card" aria-labelledby="settings-diagnostics">
        <a class="row" href="settings/diagnostics">
            <span class="row__main">
                <strong id="settings-diagnostics">@L["settings.diagnosticsLink"]</strong>
                <span class="meta">@L["settings.diagnosticsHint"]</span>
            </span>
            <span class="row__chevron" aria-hidden="true">›</span>
        </a>
    </section>
</div>

@code {
    // The values app.js stores and answers (UI-SPEC 2.1/2.3), not user-visible text.
    private const string Light = "light";
    private const string Dark = "dark";
    private const string SystemTheme = "system";

    private SettingsModel? _model;
    private EditContext? _editContext;
    private string? _loadError;
    private bool _saving;
    private bool _forgetting;
    private bool _confirmForget;
    private string? _theme;
    private bool _disposed;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // A choice made in the top-bar theme picker (UI-SPEC 2.4: one choice, one BrowserBridge) checks the radio here.
        Browser.ThemeChanged += OnThemeChanged;
        await LoadAsync();
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        _disposed = true;
        Browser.ThemeChanged -= OnThemeChanged;
        if (_editContext is not null)
        {
            _editContext.OnValidationStateChanged -= OnValidationStateChanged;
        }
    }

    private void OnThemeChanged(string theme)
    {
        if (theme is not (Light or Dark or SystemTheme))
        {
            return;
        }

        Observe(InvokeAsync(() =>
        {
            if (_disposed || theme == _theme)
            {
                return;
            }

            _theme = theme;
            StateHasChanged();
        }));
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = await Browser.GetThemeAsync();
            StateHasChanged();
        }
        catch (JSException)
        {
            // The module could not answer (blocked storage is handled in app.js); the radios stay unchecked.
        }
    }

    /// <inheritdoc />
    protected override void OnLanguageChanged()
    {
        // Messages are translated when they are produced: produce the shown ones again in the new language.
        if (_editContext is not null && _editContext.GetValidationMessages().Any())
        {
            _editContext.Validate();
        }
    }

    private string SpotifyLine(StatusDto status) => status switch
    {
        { SpotifyConnected: true, SpotifyUser: { Length: > 0 } user } => L.Format("settings.spotifyConnected", ("user", user)),
        { SpotifyConnected: true } => L["settings.spotifyConnectedNoUser"],
        _ => L["settings.spotifyNotConnected"],
    };

    private async Task ChooseThemeAsync(string theme)
    {
        _theme = theme;
        try
        {
            await Browser.SetThemeAsync(theme);
        }
        catch (JSException)
        {
            // Applying failed in the browser; the choice is still shown here.
        }
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _model = SettingsModel.From(await Commands.Api.GetSettingsAsync(Lifetime));
            if (_editContext is not null)
            {
                // Retry and Reset replace the context: keep exactly one handler attached, like Browser.ThemeChanged.
                _editContext.OnValidationStateChanged -= OnValidationStateChanged;
            }

            _editContext = new EditContext(_model);
            // The latency messages are rendered by this page (see the field), and a failed parse changes only the
            // validation state, not the model: re-render on every validation change.
            _editContext.OnValidationStateChanged += OnValidationStateChanged;
        }
        catch (Exception ex) when (BridgeCommands.IsFailure(ex, Lifetime))
        {
            _loadError = BridgeCommands.Describe(ex, L);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested)
        {
            // the page went away
        }
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (await Commands.SaveSettingsAsync(_model.ToDto(), Lifetime) is { } saved && _editContext is not null)
            {
                // Keep the EditContext (EditForm re-creates its inputs for a new one, which drops the focus): take the
                // saved values into the same model and mark the form clean.
                _model.DeviceName = saved.DeviceName;
                _model.LatencyFrames = saved.LatencyFrames;
                _model.PollReceiverVolume = saved.PollReceiverVolume;
                _model.PreferredStream = saved.PreferredStream;
                _editContext.MarkAsUnmodified();
                _editContext.NotifyValidationStateChanged();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ForgetSpotifyAsync()
    {
        _forgetting = true;
        try
        {
            // On failure BridgeCommands raises the notice and the confirm stays open, so trying again is one tap.
            if (await Commands.ForgetSpotifyAsync(Lifetime))
            {
                _confirmForget = false;
            }
        }
        finally
        {
            _forgetting = false;
        }
    }
}
