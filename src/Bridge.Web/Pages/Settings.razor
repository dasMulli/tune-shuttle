@page "/settings"
@inherits BridgeComponentBase
@using Microsoft.Extensions.Logging
@inject BrowserBridge Browser

@* UI-SPEC 4.6: one narrow column of cards (Bridge form, AirPlay receiver form (SPEC-receiver.md 9.2), Appearance, Spotify,
   Diagnostics link). *@

<PageTitle>@L.Format("app.pageTitle", ("page", L["nav.settings"]))</PageTitle>

<div class="stack stack--narrow">
    <h1>@L["settings.title"]</h1>

    @if (_editContext is null || _model is null)
    {
        <section class="card" aria-labelledby="settings-bridge">
            <div class="card__head"><h2 id="settings-bridge">@L["settings.bridge"]</h2></div>
            @if (_loadFailure is null)
            {
                <p class="meta">@L["common.loading"]</p>
            }
            else
            {
                <p class="meta text-err" role="alert">@L.Format("settings.loadFailed", ("detail", BridgeCommands.Describe(_loadFailure, L)))</p>
                <div class="actions">
                    <button type="button" class="btn" @onclick="RetryLoadAsync" @ref="_retryButton">@L["common.retry"]</button>
                </div>
            }
        </section>
    }
    else
    {
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="card settings" novalidate aria-labelledby="settings-bridge">
            <DataAnnotationsValidator />
            <div class="card__head"><h2 id="settings-bridge">@L["settings.bridge"]</h2></div>
            @if (_loadFailure is not null)
            {
                @* A failed reload (Reset) while the form is shown: say so above the values it could not replace. *@
                <p class="meta text-err" role="alert">@L.Format("settings.loadFailed", ("detail", BridgeCommands.Describe(_loadFailure, L)))</p>
                <div class="actions">
                    <button type="button" class="btn settings-retry" @onclick="ReloadAsync" aria-disabled="@Busy(_saving)">@L["common.retry"]</button>
                </div>
            }

            <div class="field">
                <label for="device-name">@L["settings.deviceName"]</label>
                <InputText id="device-name" class="input" @bind-Value="_model.DeviceName" maxlength="64" autocomplete="off" aria-describedby="device-name-hint" @ref="_deviceName" />
                <ValidationMessage For="() => _model.DeviceName" role="alert" />
                <p class="hint" id="device-name-hint">@L["settings.deviceNameHint"]</p>
            </div>

            <div class="field">
                <label for="latency">@L["settings.latency"]</label>
                @* InputNumber checks the parse itself, before any attribute runs: an empty field or "1e" stores
                   ParsingErrorMessage. That message is the catalog key (no {0}, so string.Format keeps it as is) and is
                   rendered through L[…] here, so it never shows the C# property name and follows a language switch. The
                   attribute messages are already text (SettingsModel.CatalogMessage) and pass L[…] unchanged. *@
                <InputNumber id="latency" class="input" @bind-Value="_model.LatencyFrames" inputmode="numeric"
                             ParsingErrorMessage="settings.validation.latencyNumber"
                             min="@SettingsModel.MinLatencyFrames" max="@SettingsModel.MaxLatencyFrames" step="441" aria-describedby="latency-hint" />
                @foreach (var message in _editContext.GetValidationMessages(() => _model.LatencyFrames))
                {
                    <div class="validation-message" role="alert">@L[message]</div>
                }
                <p class="hint" id="latency-hint">
                    @L.Format("settings.latencyHint",
                        ("ms", Format.Milliseconds(_model.LatencyFrames)),
                        ("min", Format.Integer(SettingsModel.MinLatencyFrames)),
                        ("max", Format.Integer(SettingsModel.MaxLatencyFrames)))
                    @L["settings.latencyHint2"]
                </p>
            </div>

            <div class="field">
                <label for="stream">@L["settings.stream"]</label>
                <InputSelect id="stream" class="input" @bind-Value="_model.PreferredStream" aria-describedby="stream-hint">
                    <option value="Realtime">@L["settings.streamRealtime"]</option>
                    <option value="Buffered">@L["settings.streamBuffered"]</option>
                </InputSelect>
                <ValidationMessage For="() => _model.PreferredStream" role="alert" />
                <p class="hint" id="stream-hint">@L["settings.streamHint"]</p>
            </div>

            @* Built like the Appearance radios: the label wraps the checkbox and is the whole 44px row on phones (5.4/5.6),
               and both kinds of check rows share one typography. The hint sits under the text column (box + gap). *@
            <div class="field">
                <label class="field--check" for="poll">
                    <InputCheckbox id="poll" @bind-Value="_model.PollReceiverVolume" aria-describedby="poll-hint" />
                    <span>@L["settings.poll"]</span>
                </label>
                <p class="hint hint--check" id="poll-hint">@L["settings.pollHint"]</p>
            </div>

            @* Whole days in the spinner; the service also takes fractions (Bridge:ForgetOfflineAfter may be "12:00:00"), so
               the field is an InputNumber<double> and shows such a value as it is. Messages as for the latency field. *@
            <div class="field">
                <label for="forget-offline">@L["settings.forgetOfflineAfter"]</label>
                <InputNumber id="forget-offline" class="input input--narrow" @bind-Value="_model.ForgetOfflineAfterDays" inputmode="decimal"
                             ParsingErrorMessage="settings.validation.forgetDaysNumber"
                             min="0" max="@SettingsModel.MaxForgetOfflineAfterDays" step="1" aria-describedby="forget-offline-hint" />
                @foreach (var message in _editContext.GetValidationMessages(() => _model.ForgetOfflineAfterDays))
                {
                    <div class="validation-message" role="alert">@L[message]</div>
                }
                <p class="hint" id="forget-offline-hint">@L["settings.forgetOfflineAfterHint"]</p>
            </div>

            <div class="actions">
                @* aria-disabled while saving, not disabled: Chromium blurs a focused button that becomes disabled, so the
                   keyboard focus would fall to <body>; the handlers ignore a press meanwhile. *@
                <button type="submit" class="btn btn--primary" aria-disabled="@Busy(_saving)" aria-busy="@Busy(_saving)">@(_saving ? L["settings.saving"] : L["settings.save"])</button>
                <button type="button" class="btn btn--ghost" @onclick="ReloadAsync" aria-disabled="@Busy(_saving)">@L["settings.reset"]</button>
            </div>
        </EditForm>

        @if (_model.AirplayOffered)
        {
            @* SPEC-receiver.md 9.2: the AirPlay receiver card. A second form on the same EditContext and model: the Bridge
               form's validator checks both cards, and either Save sends the one PUT /api/settings with every field (the
               password by the null-keeps rule of 9.1, SettingsModel.ToDto). No validator of its own here: a second one
               would add every message twice. *@
            <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="card settings-airplay" novalidate aria-labelledby="settings-airplay">
                <div class="card__head"><h2 id="settings-airplay">@L["settings.airplay"]</h2></div>

                <div class="field">
                    <label class="field--check" for="airplay-enabled">
                        <InputCheckbox id="airplay-enabled" @bind-Value="_model.AirplayEnabled" />
                        <span>@L["settings.airplayEnabled"]</span>
                    </label>
                </div>

                <div class="field">
                    <label for="airplay-name">@L["settings.airplayName"]</label>
                    <InputText id="airplay-name" class="input" @bind-Value="_model.AirplayName" maxlength="@SettingsModel.MaxAirplayNameLength" autocomplete="off" aria-describedby="airplay-name-hint" />
                    <ValidationMessage For="() => _model.AirplayName" role="alert" />
                    <p class="hint" id="airplay-name-hint">@L["settings.airplayNameHint"]</p>
                </div>

                <div class="field">
                    <label for="airplay-password">@L["settings.airplayPassword"]</label>
                    @* type=password with new-password: the browser neither shows the secret over a shoulder nor fills in a
                       saved login; the service never answers the password, so the field starts empty. *@
                    <InputText id="airplay-password" type="password" class="input" @bind-Value="_model.AirplayPassword" maxlength="@SettingsModel.MaxAirplayPasswordLength"
                               autocomplete="new-password" aria-describedby="@AirplayPasswordDescribedBy" @ref="_airplayPassword" />
                    <ValidationMessage For="() => _model.AirplayPassword" role="alert" />
                    <p class="hint" id="airplay-password-hint">@L["settings.airplayPasswordHint"]</p>
                    @if (_model.KeepsStoredAirplayPassword)
                    {
                        <p class="hint" id="airplay-password-state">@L["settings.airplayPasswordSetHint"]</p>
                        <div class="actions">
                            <button type="button" class="btn btn--ghost airplay-remove-password" @onclick="RemoveAirplayPassword" aria-disabled="@Busy(_saving)">@L["settings.airplayRemovePassword"]</button>
                        </div>
                    }
                    else if (_model.AirplayPasswordRemoved && string.IsNullOrEmpty(_model.AirplayPassword))
                    {
                        <p class="hint" id="airplay-password-state">@L["settings.airplayPasswordRemoved"]</p>
                    }
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn--primary" aria-disabled="@Busy(_saving)" aria-busy="@Busy(_saving)">@(_saving ? L["settings.saving"] : L["settings.save"])</button>
                    <button type="button" class="btn btn--ghost" @onclick="ReloadAsync" aria-disabled="@Busy(_saving)">@L["settings.reset"]</button>
                </div>
            </EditForm>
        }
    }

    <section class="card" aria-labelledby="settings-appearance">
        <div class="card__head"><h2 id="settings-appearance">@L["settings.appearance"]</h2></div>
        <fieldset class="field">
            <legend>@L["settings.theme"]</legend>
            @* The whole row is the label (it wraps its radio and names it with for=), so the full 44px row is the target. *@
            <label class="field--check" for="settings-theme-light">
                <input id="settings-theme-light" type="radio" name="settings-theme" value="light" checked="@(_theme == Light)" @onchange="() => ChooseThemeAsync(Light)" />
                <span>@L["theme.light"]</span>
            </label>
            <label class="field--check" for="settings-theme-dark">
                <input id="settings-theme-dark" type="radio" name="settings-theme" value="dark" checked="@(_theme == Dark)" @onchange="() => ChooseThemeAsync(Dark)" />
                <span>@L["theme.dark"]</span>
            </label>
            <label class="field--check" for="settings-theme-system">
                <input id="settings-theme-system" type="radio" name="settings-theme" value="system" checked="@(_theme == SystemTheme)" @onchange="() => ChooseThemeAsync(SystemTheme)" />
                <span>@L["theme.system"]</span>
            </label>
        </fieldset>
        <div class="field">
            <label for="settings-language">@L["settings.language"]</label>
            <LanguageSelect Variant="@LanguageSelect.Field" Id="settings-language" />
        </div>
    </section>

    <section class="card" aria-labelledby="settings-spotify">
        <div class="card__head"><h2 id="settings-spotify" tabindex="-1" @ref="_spotifyTitle">@L["settings.spotify"]</h2></div>
        @if (State.Status is { } status)
        {
            <p>@SpotifyLine(status)</p>
        }
        else
        {
            <p class="meta">@L["common.loading"]</p>
        }
        @if (_confirmForget)
        {
            <p>@L["settings.forgetConfirm"]</p>
            <div class="actions">
                <button type="button" class="btn btn--danger" @onclick="ForgetSpotifyAsync" aria-disabled="@Busy(_forgetting)" aria-busy="@Busy(_forgetting)">@L["settings.forget"]</button>
                <button type="button" class="btn" @onclick="KeepSpotify" aria-disabled="@Busy(_forgetting)" @ref="_keepButton">@L["common.keep"]</button>
            </div>
        }
        else
        {
            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="ConfirmForget" @ref="_forgetButton">@L["settings.forgetSpotify"]</button>
            </div>
        }
    </section>

    <section class="card" aria-labelledby="settings-diagnostics">
        <a class="row" href="settings/diagnostics">
            <span class="row__main">
                <strong id="settings-diagnostics">@L["settings.diagnosticsLink"]</strong>
                <span class="meta">@L["settings.diagnosticsHint"]</span>
            </span>
            <span class="row__chevron" aria-hidden="true">›</span>
        </a>
    </section>
</div>

@code {
    // The values app.js stores and answers (UI-SPEC 2.1/2.3), not user-visible text.
    private const string Light = "light";
    private const string Dark = "dark";
    private const string SystemTheme = "system";

    private SettingsModel? _model;
    private EditContext? _editContext;
    private Exception? _loadFailure; // kept, not its text: the message is described in the current language per render
    private bool _saving;
    private bool _forgetting;
    private bool _confirmForget;
    private string? _theme;
    private bool _disposed;

    // The element to focus after the next render: the swaps below replace the pressed button (Forget Spotify ↔ the
    // Forget/Keep pair, the load Retry → the form), which would drop the keyboard focus to <body>.
    private Focus _focus;
    private ElementReference _retryButton;
    private InputText? _deviceName;
    private InputText? _airplayPassword;
    private ElementReference _spotifyTitle;
    private ElementReference _forgetButton;
    private ElementReference _keepButton;

    /// <summary>The Spotify card's heading (tests: where the focus goes after a successful forget).</summary>
    internal ElementReference SpotifyTitle => _spotifyTitle;

    private enum Focus
    {
        None,
        Retry,
        DeviceName,
        AirplayPassword,
        ForgetSpotify,
        Keep,
        SpotifyTitle,
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // A choice made in the top-bar theme picker (UI-SPEC 2.4: one choice, one BrowserBridge) checks the radio here.
        Browser.ThemeChanged += OnThemeChanged;
        await LoadAsync();
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        _disposed = true;
        Browser.ThemeChanged -= OnThemeChanged;
        if (_editContext is not null)
        {
            _editContext.OnValidationStateChanged -= OnValidationStateChanged;
        }
    }

    private void OnThemeChanged(string theme)
    {
        if (theme is not (Light or Dark or SystemTheme))
        {
            return;
        }

        Observe(InvokeAsync(() =>
        {
            if (_disposed || theme == _theme)
            {
                return;
            }

            _theme = theme;
            StateHasChanged();
        }));
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focus != Focus.None)
        {
            await FocusAsync();
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = await Browser.GetThemeAsync();
            StateHasChanged();
        }
        catch (JSException)
        {
            // The module could not answer (blocked storage is handled in app.js); the radios stay unchecked.
        }
    }

    private async Task FocusAsync()
    {
        ElementReference? element = _focus switch
        {
            Focus.Retry => _retryButton,
            Focus.DeviceName => _deviceName?.Element,
            Focus.AirplayPassword => _airplayPassword?.Element,
            Focus.ForgetSpotify => _forgetButton,
            Focus.Keep => _keepButton,
            _ => _spotifyTitle,
        };
        _focus = Focus.None;
        if (element is not { Context: not null } target)
        {
            return; // not rendered (yet)
        }

        try
        {
            await target.FocusAsync();
        }
        catch (JSException)
        {
            // the element went away between the render and the call
        }
        catch (JSDisconnectedException)
        {
            // the page is going away
        }
    }

    /// <inheritdoc />
    protected override void OnLanguageChanged()
    {
        // Messages are translated when they are produced: produce the shown ones again in the new language.
        if (_editContext is not null && _editContext.GetValidationMessages().Any())
        {
            _editContext.Validate();
        }
    }

    private string SpotifyLine(StatusDto status) => status switch
    {
        { SpotifyConnected: true, SpotifyUser: { Length: > 0 } user } => L.Format("settings.spotifyConnected", ("user", user)),
        { SpotifyConnected: true } => L["settings.spotifyConnectedNoUser"],
        _ => L["settings.spotifyNotConnected"],
    };

    private async Task ChooseThemeAsync(string theme)
    {
        _theme = theme;
        try
        {
            await Browser.SetThemeAsync(theme);
        }
        catch (JSException)
        {
            // Applying failed in the browser; the choice is still shown here.
        }
    }

    private async Task LoadAsync()
    {
        _loadFailure = null;
        try
        {
            _model = SettingsModel.From(await Commands.Api.GetSettingsAsync(Lifetime));
            if (_editContext is not null)
            {
                // Retry and Reset replace the context: keep exactly one handler attached, like Browser.ThemeChanged.
                _editContext.OnValidationStateChanged -= OnValidationStateChanged;
            }

            _editContext = new EditContext(_model);
            // The latency messages are rendered by this page (see the field), and a failed parse changes only the
            // validation state, not the model: re-render on every validation change.
            _editContext.OnValidationStateChanged += OnValidationStateChanged;
        }
        catch (Exception ex) when (BridgeCommands.IsFailure(ex, Lifetime))
        {
            _loadFailure = ex;
            LoggerFactory.CreateLogger<Settings>().LogWarning("Loading the settings failed: {Error}", ex.Message);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested)
        {
            // the page went away
        }
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    /// <summary>The aria-disabled / aria-busy value: "true" or no attribute.</summary>
    private static string? Busy(bool busy) => busy ? "true" : null;

    /// <summary>Reset and the in-form Retry: ignored while a save runs (the buttons are aria-disabled then).</summary>
    private Task ReloadAsync() => _saving ? Task.CompletedTask : LoadAsync();

    /// <summary>The Retry of a failed first load: the form replaces the button, so the focus goes to its first field.</summary>
    private async Task RetryLoadAsync()
    {
        await LoadAsync();
        _focus = _editContext is not null ? Focus.DeviceName : Focus.Retry;
    }

    /// <summary>The password field's hints: the state line joins the general hint while it is shown (SPEC-receiver.md 9.2).</summary>
    private string AirplayPasswordDescribedBy =>
        _model is { KeepsStoredAirplayPassword: true } or { AirplayPasswordRemoved: true, AirplayPassword: null or "" }
            ? "airplay-password-hint airplay-password-state"
            : "airplay-password-hint";

    /// <summary>
    /// The "remove password" ghost button (SPEC-receiver.md 9.1-9.2): the next save sends <c>""</c>. The button goes away
    /// with the press, so the focus moves to the password field.
    /// </summary>
    private void RemoveAirplayPassword()
    {
        if (_model is null || _saving)
        {
            return;
        }

        _model.RemoveAirplayPassword();
        _editContext?.NotifyFieldChanged(_editContext.Field(nameof(SettingsModel.AirplayPassword)));
        _focus = Focus.AirplayPassword;
    }

    private void ConfirmForget()
    {
        _confirmForget = true;
        _focus = Focus.Keep;
    }

    private void KeepSpotify()
    {
        if (!_forgetting)
        {
            _confirmForget = false;
            _focus = Focus.ForgetSpotify;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null || _saving)
        {
            return;
        }

        _saving = true;
        try
        {
            if (await Commands.SaveSettingsAsync(_model.ToDto(), Lifetime) is { } saved && _editContext is not null)
            {
                // Keep the EditContext (EditForm re-creates its inputs for a new one, which drops the focus): take the
                // saved values into the same model (the password field empties: the answer never carries it) and mark
                // the form clean.
                _model.Accept(saved);
                _editContext.MarkAsUnmodified();
                _editContext.NotifyValidationStateChanged();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ForgetSpotifyAsync()
    {
        if (_forgetting)
        {
            return;
        }

        _forgetting = true;
        try
        {
            // On failure BridgeCommands raises the notice and the confirm stays open, so trying again is one tap.
            if (await Commands.ForgetSpotifyAsync(Lifetime))
            {
                _confirmForget = false;
                _focus = Focus.SpotifyTitle; // the pair is gone; the card's heading leads on to its new state
            }
        }
        finally
        {
            _forgetting = false;
        }
    }
}
