@page "/"
@inherits BridgeComponentBase

<PageTitle>Now Playing · AirPlay Bridge</PageTitle>

<h1>Now Playing</h1>

@{
    var playback = State.Playback;
    var spotifyConnected = State.Status?.SpotifyConnected == true;
}

<section class="now-playing card">
    <div class="artwork">
        @if (playback?.ArtworkUrl is { Length: > 0 } artwork)
        {
            <img src="@artwork" alt="Cover of @(playback.Album ?? playback.Title)" />
        }
        else
        {
            <div class="artwork-placeholder" aria-hidden="true">♪</div>
        }
    </div>
    <div class="track">
        @if (playback?.Title is { } title)
        {
            <h2 class="title">@title</h2>
            <p class="artist">@playback.Artist</p>
            <p class="album muted">@playback.Album</p>
        }
        else
        {
            <h2 class="title muted">Nothing playing</h2>
            <p class="muted">
                @(spotifyConnected
                    ? "Start playback in a Spotify app."
                    : $"Select \"{State.Status?.DeviceName ?? "the bridge"}\" as the device in a Spotify app.")
            </p>
        }

        @if (playback is not null && playback.DurationMs > 0)
        {
            var position = State.PlaybackPositionMs();
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@playback.DurationMs" aria-valuenow="@position">
                <div class="progress-bar" style="width: @Percent(position, playback.DurationMs)%"></div>
            </div>
            <p class="times muted"><span>@Format.PlaybackTime(position)</span><span>@Format.PlaybackTime(playback.DurationMs)</span></p>
        }

        <div class="transport">
            <button type="button" aria-label="Previous" @onclick='() => CommandAsync("prev")' disabled="@(!spotifyConnected || _busy)">⏮</button>
            @if (playback?.Playing == true)
            {
                <button type="button" class="primary" aria-label="Pause" @onclick='() => CommandAsync("pause")' disabled="@(!spotifyConnected || _busy)">⏸</button>
            }
            else
            {
                <button type="button" class="primary" aria-label="Play" @onclick='() => CommandAsync("play")' disabled="@(!spotifyConnected || _busy)">▶</button>
            }
            <button type="button" aria-label="Next" @onclick='() => CommandAsync("next")' disabled="@(!spotifyConnected || _busy)">⏭</button>
        </div>

        <p class="spotify-volume">
            Spotify volume <meter min="0" max="100" value="@(playback?.SpotifyVolume ?? 0)"></meter> @(playback?.SpotifyVolume ?? 0)
        </p>
    </div>
</section>

<section class="card output-summary">
    <h2>Output</h2>
    @{
        var output = State.Output;
    }
    @if (output.GroupId is null && output.ReceiverId is null)
    {
        <p class="muted">Nothing selected: audio is discarded. Connect a receiver or activate a group.</p>
    }
    else
    {
        <p>
            @if (output.GroupId is { } groupId)
            {
                <span>Group <a href="groups">@(State.Group(groupId)?.Name ?? groupId)</a>, master level @output.MasterLevel</span>
            }
            else
            {
                <span>@State.NameOf(output.ReceiverId!), level @output.MasterLevel</span>
            }
        </p>
        <ul class="members compact">
            @foreach (var member in output.Members)
            {
                <li @key="member.ReceiverId"><span class="member-name">@member.Name</span> <StateBadge State="member.State" /> <span class="muted">r_i @member.Level</span></li>
            }
        </ul>
    }
</section>

@code {
    private bool _busy;

    private static string Percent(long position, long duration) =>
        (duration <= 0 ? 0 : Math.Clamp(position * 100.0 / duration, 0, 100)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // The position is extrapolated between playbackChanged events; redraw once a second while playing.
        Every(TimeSpan.FromSeconds(1), async _ =>
        {
            if (State.Playback?.Playing == true)
            {
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task CommandAsync(string command)
    {
        _busy = true;
        try
        {
            await Commands.PlaybackAsync(command, Lifetime);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested)
        {
            // the page went away
        }
        finally
        {
            _busy = false;
        }
    }
}
