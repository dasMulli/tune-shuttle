{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Airplay2": "Information",
      "Librespot": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  },
  "DataDirectory": null,
  "Bridge": {
    "DeviceName": "AirPlay Bridge",
    "LatencyFrames": 77175,
    "PreferredStream": "Realtime",
    "PollReceiverVolumeSeconds": 3,
    "ZeroconfPort": 0,
    "SenderPorts": { "Timing": 0, "Control": 0 },
    "EnableSpotify": true,
    "BrowseReceivers": true,
    "FileLogging": true,
    "LogRetentionDays": 7,
    "LocalAddress": null,
    "ConnectTimeout": "00:01:00",
    "ReconnectDelay": "00:00:05",
    "MaxReconnectDelay": "00:05:00",
    "ForgetOfflineAfter": "3.00:00:00",
    "FakeReceivers": 0
  }
}
