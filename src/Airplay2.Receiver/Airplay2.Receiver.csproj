<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Airplay2.Receiver</RootNamespace>
    <!-- FFmpeg.AutoGen exposes the libavcodec structs as pointers (Codecs/FfmpegAacDecoder.cs, SPEC-receiver.md 7.2). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>AirPlay 2 receiver library (docs/airplay2/SPEC-receiver.md R2): the AirplayReceiver facade that advertises _airplay._tcp and _raop._tcp, accepts one sender at a time over HAP pairing and the encrypted control channel, follows its PTP clock, decodes realtime ALAC and buffered ALAC or AAC-LC (libavcodec) streams into a playout buffer and drives the host's audio output with pause, flush, volume and now-playing. Built from the fake receiver's code; references Airplay2.Sender for the shared protocol parts and Librespot.Discovery for the mDNS responder; no ASP.NET, Spotify or SQLite code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airplay2.Sender\Airplay2.Sender.csproj" />
    <ProjectReference Include="..\..\librespot-dotnet\src\Librespot.Discovery\Librespot.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- AAC-LC through libavcodec (SPEC-receiver.md R4, 7.2); the native libraries are not part of the package. -->
    <PackageReference Include="FFmpeg.AutoGen" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captured /info template (SPEC-receiver.md 3.2), one copy shared with the docs and the fake receiver. -->
    <EmbeddedResource Include="..\..\docs\airplay2\test-vectors\info-response.bplist" LogicalName="Airplay2.Receiver.info-response.bplist" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Airplay2.Receiver.Tests" />
    <!-- The extraction tests (tests/Airplay2.Sender.Tests/ReceiverLibrary) drive the pairing registry and store flush. -->
    <InternalsVisibleTo Include="Airplay2.Sender.Tests" />
  </ItemGroup>

</Project>
