# Build context for docker/Dockerfile: sources only. Windows bin/obj trees, the reference checkouts, docs, tests and
# artifacts are not needed inside the image build (restore regenerates obj on Linux).
**/bin/
**/obj/
**/.vs/
**/.csdevkit/
**/TestResults/
.git/
.gitignore
.local/
artifacts/
reference/
docs/
# ... except the captured /info template that src/Airplay2.Receiver embeds (docs/airplay2/SPEC-receiver.md 3.2).
!docs/airplay2/test-vectors/info-response.bplist
tests/
docker/
install/
librespot-dotnet/target/
librespot-dotnet/**/bin/
librespot-dotnet/**/obj/
librespot-dotnet/tests/
**/*.user
**/*.suo
